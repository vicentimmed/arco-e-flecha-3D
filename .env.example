# Variáveis opcionais — o Dockerfile já define valores seguros.
# No EasyPanel: aba Environment (só precisará se quiser mudar a porta).

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# A CHAVE DA SALA. Vazia = sala aberta a qualquer um que ache o domínio (é o
# certo em `npm run dev`, e o errado numa VPS com domínio público).
# Com ela definida, entra só quem abrir o link com `?k=<chave>`:
#
#   https://SEU_DOMINIO/?k=SUA_CHAVE_AQUI
#
# O site continua público — o robô carrega a página e não entra na sala.
# Aceita uma LISTA separada por vírgula, que é como se troca a chave sem
# derrubar quem está jogando: publica a nova, deixa a velha valendo um tempo,
# e só depois tira a velha da lista.
ROOM_KEY=
